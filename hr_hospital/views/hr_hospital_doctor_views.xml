<odoo>

    <record id="view_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <field name="mentor_id"/>
                <field name="user_id"/>
                <field name="blood_group"/>
                <field name="gender"/>
                <field name="birth_date"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Doctor Information">
                            <field name="name"/>
                            <field name="specialization"/>
                            <field name="category_id"/>
                            <field name="mentor_id"
                                   domain="[('is_intern', '=', False)]"
                                   invisible="not is_intern"
                                   required="is_intern"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Medical Information">
                            <field name="blood_group"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group string="History">
                            <field name="patient_ids"/>
                            <field name="visit_ids"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctors" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_doctors"
              action="action_doctors"
              parent="hr_hospital_doctors_menu"
              name="Doctors"
              sequence="200"/>

</odoo>