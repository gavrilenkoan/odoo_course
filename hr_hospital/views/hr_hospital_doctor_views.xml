<odoo>

    <record id="view_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <field name="mentor_id"/>
                <field name="user_id"/>
                <field name="blood_group"/>
                <field name="gender"/>
                <field name="birth_date"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Doctor Information">
                            <field name="image_url" widget="image_url" options="{'size': [128, 250]}"/>
                            <field name="name"/>
                            <field name="specialization"/>
                            <field name="category_id"/>
                            <field name="is_intern"/>
                            <field name="mentor_id"
                                   domain="[('is_intern', '=', False)]"
                                   invisible="not is_intern"
                                   required="is_intern"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Medical Information">
                            <field name="blood_group"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group string="History">
                            <field name="patient_ids"/>
                            <field name="visit_ids"/>
                        </group>
                    </group>
                    <group string="Interns" invisible="not intern_ids">
                        <field name="intern_ids" nolabel="1">
                            <kanban>
                                <templates>
                                    <t t-name="card">
                                        <div class="d-flex">
                                            <field name="image_url" widget="image_url"
                                                   options="{'size': [48, 48]}" class="me-2"/>
                                            <div>
                                                <strong><field name="name"/></strong>
                                                <div><field name="specialization"/></div>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_doctor_kanban" model="ir.ui.view">
        <field name="name">hospital.doctor.kanban</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id">
                <field name="mentor_id"/>
                <field name="image_url"/>
                <field name="intern_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="image_url" widget="image_url"
                                   options="{'size': [64, 100]}" class="me-3"/>
                            <div class="flex-grow-1">
                                <strong class="fs-5"><field name="name"/></strong>
                                <div>Specialization: <field name="specialization"/></div>
                                <div>Qualification: <field name="category_id"/></div>
                                <div t-if="record.mentor_id.raw_value" class="text-muted">
                                    Mentor: <field name="mentor_id"/>
                                </div>
                                <div t-if="record.intern_ids.raw_value.length">
                                    Interns: <field name="intern_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                        <footer>
                            <button name="action_create_visit" type="object"
                                    string="New Visit" class="btn btn-sm btn-link"/>
                        </footer>
                    </t>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Open</a>
                        <a role="menuitem" type="archive" class="dropdown-item">Archive</a>
                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_doctor_search" model="ir.ui.view">
        <field name="name">hospital.doctor.search</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <filter name="filter_interns" string="Interns"
                        domain="[('is_intern', '=', True)]"/>
                <filter name="filter_mentors" string="Mentors"
                        domain="[('intern_ids', '!=', False)]"/>
                <group>
                    <filter name="group_category" string="Qualification"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_doctors" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="menu_doctors"
              action="action_doctors"
              parent="hr_hospital_doctors_menu"
              name="Doctors"
              sequence="200"/>

</odoo>
