<odoo>

    <record id="view_doctor_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.list ()</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="patient_ids"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form ()</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialization"/>
                        </group>

                        <group>
                            <field name="patient_ids"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctors" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_doctors"
              action="action_doctors"
              parent="hr_hospital_doctors_menu"
              name="Doctors"
              sequence="200"/>

</odoo>