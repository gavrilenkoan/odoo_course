<odoo>

    <record id="view_visit_list" model="ir.ui.view">
        <field name="name">hospital.visit.list ()</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="visit_date"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">hospital.visit.form ()</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="disease_id"/>
                        </group>

                        <group>
                            <field name="visit_date"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_visits" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_visits"
              action="action_visits"
              parent="hr_hospital_visits_menu"
              name="Visits"
              sequence="800"/>

</odoo>