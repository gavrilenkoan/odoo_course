<odoo>

    <record id="view_visit_list" model="ir.ui.view">
        <field name="name">hospital.visit.list</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="status"/>
                <field name="scheduled_datetime"/>
                <field name="visit_datetime"/>
                <field name="doctor_id"/>
                <field name="patient_id"/>
                <field name="disease_id"/>
            </list>
        </field>
    </record>

    <record id="view_visit_form" model="ir.ui.view">
        <field name="name">hospital.visit.form</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_done"
                        type="object"
                        string="Done"
                        invisible="status != 'planned'"
                        class="oe_highlight"/>
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="status != 'planned'"
                        class="oe_highlight"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_open_current_disease_visits"
                            icon="fa-stethoscope">
                            <field
                                name="current_disease_visit_count"
                                widget="statinfo"
                                string="Current Disease"/>
                        </button>
                    </div>
                    <group>
                        <group string="Visit Information">
                            <field name="name"/>
                            <field name="scheduled_datetime"
                                   readonly="status == 'done'"/>
                        </group>
                        <group string="Participants">
                            <field name="doctor_id"
                                   readonly="status == 'done'"/>
                            <field name="patient_id"
                                   readonly="status == 'done'"/>
                        </group>
                        <group string="Summary">
                            <field name="active"
                                   readonly="status == 'done'"/>
                            <field name="visit_datetime"
                                   readonly="status == 'done'"/>
                            <field name="disease_id"
                                   readonly="status == 'done'"/>
                            <field name="summary"
                                   readonly="status == 'done'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_visit_calendar_view" model="ir.ui.view">
        <field name="name">hospital.visit.calendar</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <calendar
                    string="Visits"
                    date_start="scheduled_datetime"
                    color="doctor_id"
                    mode="month">
                <field name="doctor_id" filters="1"/>
                <field name="disease_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="hospital_visit_search_view" model="ir.ui.view">
        <field name="name">hospital.visit.search</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>

                <filter name="filter_planned" string="Planned"
                        domain="[('status', '=', 'planned')]"/>
                <filter name="filter_done" string="Completed"
                        domain="[('status', '=', 'done')]"/>
                <filter name="filter_cancelled" string="Cancelled"
                        domain="[('status', '=', 'cancelled')]"/>

                <separator/>

                <filter name="filter_this_year" string="This Year"
                        domain="[('scheduled_datetime', '&gt;=', context_today().strftime('%Y-01-01 00:00:00')),
                                 ('scheduled_datetime', '&lt;=', context_today().strftime('%Y-12-31 23:59:59'))]"/>

                <group>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_doctor" string="Doctor"
                            context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_disease" string="Disease"
                            context="{'group_by': 'disease_id'}"/>
                </group>

                <searchpanel>
                    <field name="doctor_id" icon="fa-user-md" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="hospital_visit_pivot_view" model="ir.ui.view">
        <field name="name">hospital.visit.pivot</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits by Doctor and Status">
                <field name="doctor_id" type="row"/>
                <field name="scheduled_datetime" interval="month" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

     <record id="hospital_visit_graph_view" model="ir.ui.view">
        <field name="name">hospital.visit.graph</field>
        <field name="model">hospital.visit</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="scheduled_datetime" interval="month"/>
                <field name="disease_id"/>
            </graph>
        </field>
    </record>

    <record id="action_visits" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.visit</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="hospital_visit_search_view"/>
        <field name="context">{'search_default_filter_this_year': 1}</field>
        <field name="domain">[]</field>
    </record>

    <menuitem id="menu_visits"
              action="action_visits"
              parent="hr_hospital_visits_menu"
              name="Visits"
              sequence="800"/>

</odoo>