<odoo>

    <record id="view_doctor_history_list" model="ir.ui.view">
        <field name="name">hospital.doctor.history.list</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="assignment_date"/>
                <field name="change_date"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_history_form" model="ir.ui.view">
        <field name="name">hospital.doctor.history.form</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="assignment_date"/>
                            <field name="change_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctor_history" model="ir.actions.act_window">
        <field name="name">Doctor assignment history</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_doctor_history"
              action="action_doctor_history"
              parent="hr_hospital_patients_menu"
              name="Doctor assignment history"
              sequence="450"/>

</odoo>