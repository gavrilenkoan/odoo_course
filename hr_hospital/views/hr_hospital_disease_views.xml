<odoo>

    <record id="view_disease_list" model="ir.ui.view">
        <field name="name">hospital.disease.list</field>
        <field name="model">hospital.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_disease_form" model="ir.ui.view">
        <field name="name">hospital.disease.form</field>
        <field name="model">hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Disease Information">
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                        <group string="Disease Inheritance">
                            <field name="parent_id"/>
                            <field name="child_ids"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_disease_search" model="ir.ui.view">
        <field name="name">hospital.disease.search</field>
        <field name="model">hospital.disease</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <searchpanel>
                    <field name="parent_id"
                           icon="fa-stethoscope"
                           enable_counters="1"
                           hierarchize="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_diseases" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.disease</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_diseases"
              action="action_diseases"
              parent="hr_hospital_diseases_menu"
              name="Diseases"
              sequence="600"/>

</odoo>
