<odoo>

    <record id="view_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="doctor_id"/>
                <field name="insurance_policy_number"/>
                <field name="blood_group"/>
                <field name="gender"/>
                <field name="birth_date"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="view_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
             <form>
                <header>
                    <button name="action_create_visit"
                            string="New Visit"
                            type="object"
                            class="btn-primary"/>
                    <button name="%(action_mass_reassign_doctor_wizard)d"
                            string="Reassign Doctor"
                            type="action"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_visits"
                                icon="fa-stethoscope">
                            <field name="visit_count"
                                   widget="statinfo"
                                   string="Visits"/>
                        </button>
                    </div>
                    <group>
                        <group string="Patient Information">
                            <field name="name"/>
                            <field name="doctor_id"/>
                            <field name="phone"/>
                            <field name="insurance_policy_number"/>
                        </group>
                        <group string="Medical Information">
                            <field name="blood_group"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group string="History">
                            <field name="visit_ids"/>
                            <field name="history_ids"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"
                       string="Name / Phone"
                       filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="doctor_id"/>
            </search>
        </field>
    </record>

    <record id="action_patients" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_patients"
              action="action_patients"
              parent="hr_hospital_patients_menu"
              name="Patients"
              sequence="400"/>

</odoo>
