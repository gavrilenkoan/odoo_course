<odoo>

    <record id="view_doctor_category_list" model="ir.ui.view">
        <field name="name">hospital.doctor.category.list</field>
        <field name="model">hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="doctor_ids"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_category_form" model="ir.ui.view">
        <field name="name">hospital.doctor.category.form</field>
        <field name="model">hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="doctor_ids"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctor_categories" model="ir.actions.act_window">
        <field name="name">Qualifications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_doctor_categories"
              action="action_doctor_categories"
              parent="hr_hospital_doctors_menu"
              name="Qualifications"
              sequence="250"/>

</odoo>
