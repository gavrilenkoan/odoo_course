<odoo>

    <record id="disease_respiratory" model="hospital.disease">
        <field name="name">Respiratory Diseases</field>
        <field name="description">
            Diseases affecting the lungs and respiratory tract
        </field>
    </record>

    <record id="disease_metabolic" model="hospital.disease">
        <field name="name">Metabolic Diseases</field>
        <field name="description">
            Disorders that affect the body's metabolism and energy regulation
        </field>
    </record>

    <record id="disease_viral" model="hospital.disease">
        <field name="name">Viral Diseases</field>
        <field name="parent_id" ref="disease_respiratory"/>
        <field name="description">
            Infectious diseases caused by viruses
        </field>
    </record>

    <record id="disease_flu" model="hospital.disease">
        <field name="name">Flu</field>
        <field name="parent_id" ref="disease_viral"/>
        <field name="description">
            Influenza, viral infection affecting respiratory system
        </field>
    </record>

    <record id="disease_covid" model="hospital.disease">
        <field name="name">COVID-19</field>
        <field name="parent_id" ref="disease_viral"/>
        <field name="description">
            Coronavirus infectious disease
        </field>
    </record>

    <record id="disease_diabetes" model="hospital.disease">
        <field name="name">Diabetes</field>
        <field name="parent_id" ref="disease_metabolic"/>
        <field name="description">
            Chronic disease affecting blood sugar regulation
        </field>
    </record>

    <record id="disease_obesity" model="hospital.disease">
        <field name="name">Obesity</field>
        <field name="parent_id" ref="disease_metabolic"/>
        <field name="description">
            Chronic disease characterized by excessive body fat accumulation.
        </field>
    </record>

    <record id="disease_bacterial" model="hospital.disease">
        <field name="name">Bacterial Diseases</field>
        <field name="parent_id" ref="disease_respiratory"/>
        <field name="description">
            Infectious respiratory diseases caused by bacteria
        </field>
    </record>

    <record id="disease_pneumonia" model="hospital.disease">
        <field name="name">Pneumonia</field>
        <field name="parent_id" ref="disease_bacterial"/>
        <field name="description">
            Inflammation of the lung tissue, often bacterial
        </field>
    </record>

    <record id="disease_thyroid" model="hospital.disease">
        <field name="name">Thyroid Disorders</field>
        <field name="parent_id" ref="disease_metabolic"/>
        <field name="description">
            Disorders affecting thyroid hormone regulation
        </field>
    </record>

    <record id="disease_hypothyroidism" model="hospital.disease">
        <field name="name">Hypothyroidism</field>
        <field name="parent_id" ref="disease_thyroid"/>
        <field name="description">
            Underactive thyroid with insufficient hormone production
        </field>
    </record>

    <record id="disease_hyperthyroidism" model="hospital.disease">
        <field name="name">Hyperthyroidism</field>
        <field name="parent_id" ref="disease_thyroid"/>
        <field name="description">
            Overactive thyroid with excessive hormone production
        </field>
    </record>

</odoo>
