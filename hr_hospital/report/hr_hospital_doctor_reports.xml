<odoo>

    <record id="paperformat_doctor_a4" model="report.paperformat">
        <field name="name">Doctor Report A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_doctor" model="ir.actions.report">
        <field name="name">Doctor Report</field>
        <field name="model">hospital.doctor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_hospital.report_doctor_document</field>
        <field name="report_file">hr_hospital.report_doctor_document</field>
        <field name="print_report_name">'Doctor Report - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_doctor_a4"/>
        <field name="binding_model_id" ref="model_hospital_doctor"/>
    </record>

</odoo>
