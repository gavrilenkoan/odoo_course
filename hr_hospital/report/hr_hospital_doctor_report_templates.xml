<odoo>

    <template id="report_doctor_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="res_company"/>

                <div class="footer">
                    <div class="text-center text-muted"
                         style="border-top:1px solid #ccc; padding-top:4px; font-size:10px;">
                        Printed:
                        <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                        <t t-if="company.partner_id.city"> | City: <span t-out="company.partner_id.city"/></t>
                    </div>
                </div>

                <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
                    <div class="page">

                        <div style="margin-bottom:20px; padding-bottom:8px;
                                    border-bottom:2px solid #495057; overflow:hidden;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                 style="float:left; height:75px; width:auto;" alt="Logo"/>
                            <div style="float:right; text-align:right; font-size:11px; line-height:1.4;">
                                <div style="font-size:14px;"><strong t-out="company.name"/></div>
                                <div t-if="company.partner_id.street" t-out="company.partner_id.street"/>
                                <div><t t-out="company.partner_id.city"/> <t t-out="company.partner_id.zip"/></div>
                                <div t-if="company.phone">Tel: <t t-out="company.phone"/></div>
                                <div t-if="company.email" t-out="company.email"/>
                            </div>
                        </div>

                        <h2 class="mb-4">
                            <span t-field="doc.name"/>
                            <span class="text-muted"> — <span t-field="doc.specialization"/></span>
                        </h2>

                        <h4>Visit history</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color:#e9ecef;">
                                    <th style="width:16%;">Scheduled</th>
                                    <th style="width:16%;">Visit date</th>
                                    <th style="width:18%;">Patient</th>
                                    <th>Disease</th>
                                    <th style="width:14%;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.visit_ids.sorted(key=lambda v: v.scheduled_datetime or v.create_date, reverse=True)"
                                    t-as="visit">
                                    <t t-set="status_color"
                                       t-value="{'planned':'#ffe082','done':'#a5d6a7','cancelled':'#ef9a9a'}.get(visit.status)"/>
                                    <td><span t-field="visit.scheduled_datetime"
                                              t-options='{"widget":"datetime","format":"dd/MM/yyyy HH:mm"}'/></td>
                                    <td><span t-field="visit.visit_datetime"
                                              t-options='{"widget":"datetime","format":"dd/MM/yyyy HH:mm"}'/></td>
                                    <td><span t-field="visit.patient_id"/></td>
                                    <td><span t-field="visit.disease_id"/></td>
                                    <td t-attf-style="background-color: {{ status_color }};">
                                        <span t-field="visit.status"/>
                                    </td>
                                </tr>
                                <tr t-if="not doc.visit_ids">
                                    <td colspan="5" class="text-center text-muted">No visits recorded.</td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Patients</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color:#e9ecef;">
                                    <th>Full name</th>
                                    <th>Gender</th>
                                    <th>Birth date</th>
                                    <th>Phone</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.patient_ids" t-as="patient">
                                    <td><span t-field="patient.name"/></td>
                                    <td><span t-field="patient.gender"/></td>
                                    <td><span t-field="patient.birth_date"/></td>
                                    <td><span t-field="patient.phone"/></td>
                                </tr>
                                <tr t-if="not doc.patient_ids">
                                    <td colspan="4" class="text-center text-muted">No patients assigned.</td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
